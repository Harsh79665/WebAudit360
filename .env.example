# ==============================================================================
# WebAudit 360 — Environment Configuration Template
# Creator: Harsh Patel
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME=WebAudit 360
APP_VERSION=1.0.0
CREATOR=Harsh Patel

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Cryptographic Tokens
# IMPORTANT: Generate a strong 32+ character random secret in production
# Example: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Persistence
# Production: PostgreSQL with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/webaudit360
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/webaudit360

# Redis Broker & Task Cache
REDIS_URL=redis://redis:6379/0

# Outbound Crawl & Engine Limits
CRAWLER_DEFAULT_MAX_PAGES=100
CRAWLER_DEFAULT_MAX_DEPTH=5
CRAWLER_DEFAULT_CONCURRENCY=2
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_POLITENESS_DELAY_SECONDS=1.0
CRAWLER_MAX_RESPONSE_BYTES=10485760

# Evidence & Report Storage
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=storage_data
# S3_BUCKET=webaudit360-evidence
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional AI Explanation Layer (Disabled by default)
AI_PROVIDER_ENABLED=false
# GEMINI_API_KEY=

# Active Vulnerability Scanner (OWASP ZAP)
ZAP_PROXY_URL=http://zap:8080
# ZAP_API_KEY=

